# Local development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# On Vercel, DATABASE_URL is injected automatically when you connect a
# Neon / Supabase database from the Vercel Marketplace (Storage tab).
# Example hosted value:
# DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
